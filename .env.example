# ========================================
# DataFlow-WebUI Environment Variables
# ========================================

# ----------------------------------------
# Frontend Configuration (Vite)
# ----------------------------------------
# Base URL for API requests in production. Defaults to /
VITE_BACKEND_URL=/

# ----------------------------------------
# Backend Configuration (FastAPI & DataFlow)
# ----------------------------------------

# Environment mode (dev, prod, etc.)
ENV=dev

# Backend port
PORT=8000

# Allowed CORS origins (JSON list or comma-separated string)
# Example: '["http://localhost:60081", "http://127.0.0.1"]'
# CORS_ORIGINS=[]

# Whether to fill default values for missing fields in serving
# DEFAULT_SERVING_FILLING=true

# ----------------------------------------
# Backend Path Configurations
# ----------------------------------------
# By default, these paths resolve to the `backend/data` and `backend/cache_local` directories.
# Uncomment and modify to override.

# DATA_REGISTRY=data/data_registry.yaml
# TASK_REGISTRY=data/task_registry.json
# PIPELINE_REGISTRY=data/pipeline_registry.json
# SERVING_REGISTRY=data/serving_registry.yaml
# TEXT2SQL_DATABASE_REGISTRY=data/text2sql_database_registry.yaml
# TEXT2SQL_DATABASE_MANAGER_REGISTRY=data/text2sql_database_manager_registry.yaml
# DATAFLOW_CORE_DIR=data/dataflow_core
# OPS_JSON_PATH=data/ops.json
# PREFERENCES_PATH=data/user_preferences.json
# SQLITE_DB_DIR=data/text2sql_dbs
# CACHE_DIR=cache_local

# ----------------------------------------
# Dynamic Runtime Variables
# ----------------------------------------
# Note: Variables like API keys (e.g., OPENAI_API_KEY, HUGGING_FACE_HUB_TOKEN)
# are dynamically injected into the environment (`os.environ`) by the backend
# during pipeline execution or service instantiation based on user payload or database registries.
